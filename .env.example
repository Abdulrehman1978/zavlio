# Required now
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development

# Public optional/future
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_ENABLE_PORTAL=false
NEXT_PUBLIC_ANALYTICS_ENABLED=true
NEXT_PUBLIC_ANALYTICS_DEBUG=false
NEXT_PUBLIC_ANALYTICS_POLICY_VERSION=2026-09-v1
ANALYTICS_VISITOR_TTL_DAYS=180
ANALYTICS_SESSION_TIMEOUT_MINUTES=30
ANALYTICS_BATCH_MAX=20
ANALYTICS_POLICY_VERSION=2026-09-v1
CRM_ANALYTICS_DEFAULT_RANGE_DAYS=30
CRM_ANALYTICS_MAX_RANGE_DAYS=730
CRM_ANALYTICS_SLOW_QUERY_MS=500

# Server-only; required only when the named integration is enabled
SUPABASE_PROJECT_ID=
SUPABASE_SERVICE_ROLE_KEY=
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAILPIT_URL=http://127.0.0.1:54324
ZOHO_SMTP_HOST=
ZOHO_SMTP_PORT=
ZOHO_SMTP_USER=
ZOHO_SMTP_PASSWORD=
MAIL_FROM=hello@zavlio.online
LEAD_NOTIFICATION_RECIPIENTS=hello@zavlio.online
TURNSTILE_SECRET_KEY=
TURNSTILE_ENABLED=false
LEAD_TASK_SLA_HOURS=24
FORM_RATE_LIMIT_PER_MINUTE=10
FORM_BODY_MAX_BYTES=32768
AUTOMATION_AGENT_ID=
AUTOMATION_HMAC_SECRET=
AUTOMATION_MACHINE_KEYS_JSON=
META_AUTOMATION_ENABLED=false
META_AUTOMATION_APPROVAL_REQUIRED=true

# Content, observability, and local bridge
CONTENT_MODE=demo
SENTRY_DSN=
META_BRIDGE_HOST=127.0.0.1
META_BRIDGE_PORT=4010
ZAVLIO_CONTROL_PLANE_URL=http://127.0.0.1:3000
ZAVLIO_AGENT_KEY=
ZAVLIO_MACHINE_KEY_ID=
ZAVLIO_MACHINE_HMAC_SECRET=
ZAVLIO_BRIDGE_VERSION=0.0.0
ZAVLIO_PROTOCOL_VERSION=1
ZAVLIO_EXECUTOR_MODE=DRY_RUN_ONLY
ZAVLIO_HEARTBEAT_INTERVAL_MS=30000
ZAVLIO_POLL_INTERVAL_MS=5000
ZAVLIO_REQUEST_TIMEOUT_MS=10000
ZAVLIO_MAX_CONCURRENCY=1

# Packet 15: pinned Meta Automation adapter (disabled by default; dry-run only)
ZAVLIO_META_ADAPTER_ENABLED=false
ZAVLIO_META_ADAPTER_UPSTREAM_ROOT=external/meta-automation
ZAVLIO_META_ADAPTER_RUNTIME_DIR=.runtime/meta-automation
ZAVLIO_META_ADAPTER_CDP_URL=http://127.0.0.1:9222
ZAVLIO_META_ADAPTER_TEST_MODE=false
ZAVLIO_META_ADAPTER_REQUEST_TIMEOUT_MS=15000
ZAVLIO_META_ADAPTER_VERSION=15.0.0
LOG_LEVEL=info
