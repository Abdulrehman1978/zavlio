{
  "name": "zavlio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Zavlio digital experience, CRM, lead intelligence, and automation platform",
  "engines": {
    "node": "24.13.0",
    "pnpm": "11.19.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --filter @zavlio/config build && pnpm --filter @zavlio/web dev",
    "build": "pnpm -r --if-present run build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:integration": "node scripts/analytics-runtime-test.mjs",
    "test:integration:lead-intake": "node scripts/lead-intake-runtime-test.mjs",
    "test:integration:lead-intake:email-failure": "node scripts/lead-intake-email-failure-test.mjs",
    "test:integration:crm": "node scripts/crm-runtime-test.mjs",
    "test:integration:operations": "node scripts/operations-runtime-test.mjs",
    "test:integration:reporting": "node scripts/reporting-runtime-test.mjs",
    "test:integration:automation": "node scripts/automation-runtime-test.mjs",
    "test:integration:bridge": "node scripts/bridge-runtime-test.mjs",
    "bridge:provision-local": "node scripts/provision-bridge-agent.mjs",
    "meta:verify-pin": "node scripts/meta-verify-pin.mjs",
    "env:check": "node scripts/env-check.mjs",
    "security:scan": "node scripts/secret-scan.mjs",
    "test:security:redaction": "node scripts/log-redaction-test.mjs",
    "meta:inspect-upstream": "node scripts/meta-inspect-upstream.mjs",
    "test:integration:meta-adapter": "node scripts/meta-adapter-runtime-test.mjs",
    "test:integration:social-provider": "node scripts/social-provider-runtime-test.mjs",
    "test:performance:automation": "node scripts/automation-performance-test.mjs",
    "automation:tick": "node scripts/automation-tick.mjs",
    "test:performance:operations": "node scripts/operations-performance-test.mjs",
    "test:performance:reporting": "node scripts/reporting-performance-test.mjs",
    "leads:recalculate": "node scripts/recalculate-leads.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "pnpm audit --audit-level high",
    "db:start": "node scripts/db.mjs start",
    "db:stop": "node scripts/db.mjs stop",
    "db:status": "node scripts/db.mjs status",
    "db:reset": "node scripts/db.mjs reset",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:lint": "node scripts/db.mjs lint",
    "db:test": "node scripts/db.mjs test",
    "db:types": "node scripts/db.mjs types",
    "db:verify": "node scripts/db.mjs verify",
    "staff:bootstrap-owner": "node scripts/bootstrap-owner.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@supabase/supabase-js": "2.117.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@zavlio/crm": "workspace:*",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "29.1.1",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "supabase": "2.118.0",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
